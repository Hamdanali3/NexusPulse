# ==============================================================================
# NexusPulse — Environment Configuration (.env.example)
# Connecting AI Agents, Human Oracles & Smart Payments on PayPal
# Copy this file to .env.local and fill in any available keys.
#
# ZERO-BLOCKER DUAL-MODE GUARANTEE (Pakistan & Judge Ready):
# - When PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are set, the app connects
#   live to https://api-m.sandbox.paypal.com and loads PayPal JS SDK v6.
# - When omitted (or PAYPAL_MODE=mirror), the app automatically runs on the
#   100% Spec-Compliant Deterministic PayPal Sandbox Mirror so all Orders v2,
#   Payouts v1, Subscriptions v1, Invoicing v2, Disputes v1, Trackers v2,
#   Transaction Search v1, and Webhook flows work immediately out of the box!
# ==============================================================================

# 1. Google Gemini Interactions API (@google/genai v3.0.0)
GEMINI_API_KEY=

# 2. PayPal Developer Sandbox Credentials (https://developer.paypal.com)
# Mode: "auto" (uses live sandbox if keys exist, else mirror), "sandbox", or "mirror"
PAYPAL_MODE=auto
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=WEBHOOK-NEXUS-PULSE-SANDBOX
PAYPAL_SANDBOX_ACCESS_TOKEN=

# 3. Sandbox Buyer & Merchant Accounts for Demo / Judge Testing
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer-nexus@personal.example.com
PAYPAL_SANDBOX_MERCHANT_EMAIL=sb-merchant-nexus@business.example.com

# 4. Sponsor Integrations (Optional — rich live fallbacks included)
CHANNEL3_API_KEY=
AG_STUDIO_LICENSE_KEY=
